# Files from build
**/*.o
**/*.s
src/.depend
src/temp_builds
src/universal/network_dump.inc
.build_sha.txt
.build_date.txt
.build_diffindex.txt

# Built binary
src/stockfish*
src/-lstdc++.res

# Neural network for the NNUE evaluation
**/*.nnue

# Files generated by the instrumented tests
tsan.supp
__pycache__/
tests/syzygy
tests/bench_tmp.epd

# The 3-man corpus tests/tbfetch.sh fetches for the fuzz harness. Deliberately
# NOT tests/syzygy above: instrumented.py skips its own 4-man download when that
# directory exists, and would then wait 300s for tables nobody fetched.
tests/syzygy-3man

# resources/ is a scratch directory, not a source directory: every byte in it is
# fetched or dropped there by hand -- a toolchain built from source, a tablebase
# set, an opening book, a match runner. `.gitkeep` is the ONLY tracked entry, so
# ignore the contents wholesale and re-include that one. Listing artifact types
# one at a time is what leaves a multi-gigabyte build tree sitting outside the
# ignore rules: each new kind needs a new line and nobody adds one. This needs
# none. To commit something here anyway, `git add -f` -- and then give it a real
# home, because nothing the engine builds reads from resources/.
resources/*
!resources/.gitkeep

# uv's virtualenv; uv.lock IS tracked.
.venv/
.ruff_cache/

# fastchess writes its resume config into its working directory on exit, and
# tests/match.sh runs it from the repo root. The gate now redirects it into the
# scratch directory, so this catches a fastchess run started by hand.
config.json

__DEV/
